[Unit]
Description=Price Action Pattern Telegram Notifications
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/dp-k
EnvironmentFile=/root/dp-k/config/notifications.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MPLCONFIGDIR=/tmp/pattern-notifications-mpl
ExecStart=/root/dp-k/.venv/bin/python -m notifications.run
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/dp-k/logs/notifications
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
