{
  "telegram": {
    "token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_CHAT_ID",
    "retries": 3,
    "timeout_seconds": 20
  },
  "state_db": "logs/notifications/state.sqlite3",
